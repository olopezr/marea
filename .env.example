# Copia este archivo como .env y rellénalo. `npm start` lo carga automáticamente.

# Puerto HTTP del servidor.
PORT=8800

# Carpeta donde se guardan la base de datos de avisos y, si no defines las claves, las claves VAPID.
# En producción debe ser un volumen persistente.
DATA_DIR=./data

# Claves para las notificaciones push. Genera unas con: npm run vapid
# Si cambias las claves, todas las suscripciones existentes dejan de funcionar.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que reciben los servicios push (Google, Apple, Mozilla) si hay un problema.
VAPID_SUBJECT=mailto:tu-correo@tudominio.es

# Opcional. Clave del plan comercial de Open-Meteo (obligatoria si la app tiene uso comercial).
OPEN_METEO_API_KEY=

# Opcional. Horas de validez de la caché de Open-Meteo (por defecto 2).
# Ahorra llamadas para no sobrepasar el límite gratuito de 10.000 diarias.
OPEN_METEO_TTL_HOURS=2

# Opcional. Redirigir Open-Meteo a través de un proxy/CDN de caché (ej. Cloudflare Worker).
# OPEN_METEO_BASE_URL=https://mi-proxy-openmeteo.tu-subdominio.workers.dev
# Secreto compartido con el proxy: defínelo igual en el Worker (`wrangler secret put PROXY_SECRET`)
# para que nadie más pueda usar tu proxy.
# OPEN_METEO_PROXY_SECRET=


# Avisos en la app de iOS (APNs). Crea una clave .p8 en developer.apple.com > Keys con "Apple Push Notifications service".
# APNS_KEY es el contenido del .p8; en una sola línea, sustituye los saltos de línea por \n.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY=
APNS_BUNDLE_ID=es.marea.app
# true para las compilaciones de desarrollo de Xcode; false para TestFlight y App Store.
APNS_SANDBOX=false

# Avisos en la app de Android (Firebase Cloud Messaging). JSON completo de una cuenta de servicio
# del proyecto de Firebase (Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada).
FCM_SERVICE_ACCOUNT=

# Opcional. Activa el programador de avisos en el servidor web (por defecto true).
# Si se ejecuta un worker independiente con `npm run worker` o en un contenedor separado, pon false.
ENABLE_SCHEDULER=true

# Opcional para el worker dedicado: comprueba alertas inmediatamente al arrancar.
WORKER_RUN_ON_START=false

# Opcional. Variables para despliegues móviles automáticos con Fastlane.
# APPLE_ID=
# SUPPLY_JSON_KEY=

# Opcional. Orígenes que pueden leer la API desde otra web (la landing), separados por comas.
# CORS_ORIGINS=https://olopezr.github.io
